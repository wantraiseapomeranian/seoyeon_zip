{
  "name": "seoyeon-zip",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "dev": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:runtime": "node scripts/check-operations-runtime.mjs --local && node scripts/validate-feed-batch.mjs --local",
    "check:ui": "node scripts/check-theme.mjs && node scripts/check-photo-loading.mjs && node scripts/check-ui-audit-fixes.mjs && node scripts/check-ui-audit-fixes.mjs text"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "esbuild": "0.28.1",
    "miniflare": "5.20260908.0-alpha",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "dependencies": {
    "jose": "6.2.12",
    "jpeg-js": "0.4.4"
  }
}
