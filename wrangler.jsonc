{
  "name": "seoyeon-zip",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  // Access login redirects verified on the production hostname.
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "validation", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "seoyeon-zip-validation", "database_id": "017ec07d-d095-45f9-80f7-0dffd6f48ba0", "migrations_dir": "migrations" }],
  // Owner identity and Access settings are managed in the Cloudflare dashboard.
  "keep_vars": true,
  "limits": { "cpu_ms": 1000 },
  "ratelimits": [{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "2026091101", "simple": { "limit": 60, "period": 60 } }],
  "vars": { "COLLECTION_ENABLED": "true", "APIFY_SYNC_ENABLED": "true", "APIFY_TASK_ID": "W7bGic2wKjj2BKhSE", "PUBLIC_FEED_ENABLED": "false" },
  "triggers": { "crons": ["*/3 * * * *", "1-59/3 * * * *", "2-59/5 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
